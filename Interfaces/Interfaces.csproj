<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <RootNamespace>$(ModNameSpace).Interfaces</RootNamespace>
        <AssemblyName>$(ModName).Interfaces</AssemblyName>
        <AssemblyTitle>Interfaces For $(ModName)</AssemblyTitle>
        <Product>$(ModName)</Product>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all"/>

        <PackageReference
                Include="LethalCompany.GameLibs.Steam"
                Version="73.0.0-ngd.0"
                Private="False"
                Publicize="True"
        />

        <ProjectReference Include="../Preloader/Preloader.csproj" PrivateAssets="all" Private="false"/>
    </ItemGroup>

    <!--Publishing steps-->
    <Target Name="CopyForUpload" AfterTargets="Build">
        <PropertyGroup>
            <DistributionDir>$(SolutionDir)\Output\dist</DistributionDir>
        </PropertyGroup>

        <PropertyGroup>
            <InterfacesOutDir>$(SolutionDir)\Interfaces\$(OutDir)</InterfacesOutDir>
            <PluginsDistributionDir>$(DistributionDir)\BepInEx\plugins</PluginsDistributionDir>
        </PropertyGroup>

        <Message Importance="High" Text="Copyng Plugin to DistributionDir"/>

        <MakeDir Directories="$(PluginsDistributionDir)"/>
        <ItemGroup>
            <InterfacesOutputFiles Include="$(InterfacesOutDir)\**" Exclude="$(InterfacesOutDir)\**\*.deps.json"/>
        </ItemGroup>
        <Copy
                SourceFiles="@(InterfacesOutputFiles)"
                DestinationFolder="$(PluginsDistributionDir)"
        />
    </Target>
</Project>
